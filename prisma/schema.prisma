// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Caso {
  ot                                   String    @id
  rut                                  String?
  nombreContacto                       String?
  subStatus                            String?
  fechaEnvioFiscalia                   DateTime?
  fechaPresentacion                    DateTime?
  anioPresentacion                     String?
  rol                                  String?
  fechaResolucionTribunal              DateTime?
  fechaNotificacionResolucionTribunal  DateTime?
  resolucionTribunal                   String?
  numeroTribunal                       String?
  tribunal                             String?
  localidadComunaRegion                String?
  propietarioCaso                      String?
  montoTotalReclamadoUf                Decimal?  @db.Decimal
  ultimaModificacionPor                String?
  estadoAccionLegal                    String?
  activo                               Boolean   @default(true)
}
